# memd configuration — export these in your shell, or point your process
# manager at this file (e.g. systemd `EnvironmentFile=`). memd does not read a
# .env file by itself. In production, set secrets with your platform's secret
# store rather than a committed file.

# --- First boot ---------------------------------------------------------------
# On first start the account database must be initialized. Set MEMD_INIT_DB=1 to
# do this non-interactively, and optionally seed the initial super admin instead
# of being prompted for one.
# MEMD_INIT_DB=1
# MEMD_CREATE_SUPER_ADMIN_USERNAME=admin
# MEMD_CREATE_SUPER_ADMIN_PASSWORD=change-me

# --- Sessions -----------------------------------------------------------------
# Key used to encrypt the session cookie (AES-256-GCM). Set this in production
# so logins survive restarts and are stable across replicas. If unset, memd
# generates an ephemeral key and logins reset whenever the process restarts.
MEMD_SESSION_SECRET=change-me-to-a-long-random-string

# Absolute session-lifetime cap (Go duration, e.g. 12h, 24h). Default 24h.
# MEMD_SESSION_MAX_AGE=24h

# --- Remote terminal rendezvous (termulaa rc) ---------------------------------
# ON BY DEFAULT — no variable needed. The feature is controlled at runtime from
# the admin console (/admin → termulaa); the toggle is stored in the database,
# so it survives deploys and restarts and needs no server access. Be aware of
# what "on" means: any signed-in memd user can mint a tunnel token and expose a
# terminal running on their own machine through this server. If that is not
# something your deployment should offer, switch it off in the admin console.
#
# Emergency kill switch (escape hatch, not the normal control): set MEMD_RC=0
# to force the feature off regardless of the admin-console setting. Unset — the
# normal state — means the feature follows that setting.
# MEMD_RC=0

# Optional hardening (host mode): a dedicated hostname browsers use to reach a
# tunneled terminal, instead of /rc/t/<agent>/ paths on memd's own host. Point
# it at the same memd port in nginx (see docs/self-hosting.md — it needs its
# own DNS record and possibly its own TLS certificate).
# MEMD_RC_VIEW_HOST=term.memd.example.com

# Key for signing tunnel tokens. Optional: when unset, a dedicated key is
# derived from MEMD_SESSION_SECRET. Set it explicitly to rotate tunnel tokens
# independently of login sessions. Rotating either key invalidates all
# previously minted tunnel tokens. With neither this nor MEMD_SESSION_SECRET
# set, the feature cannot run and reports itself unavailable.
# MEMD_RC_TOKEN_SECRET=another-long-random-string

# --- Account database ---------------------------------------------------------
# Optional override for the control-plane database. Defaults to a cgo-free
# SQLite file in the memd config directory.
# MEMD_DATABASE_URL=sqlite:///var/lib/memd/memd.db

# --- OpenID Connect (SSO) -----------------------------------------------------
# OIDC is normally configured by a super admin in the web UI (/admin), and the
# configuration is stored in the database. The variables below are only used to
# SEED that configuration on first boot — handy for automated deployments.
# Leave them all unset to start with local accounts only and configure SSO later.
#
# memd is IdP-agnostic: set these four and everything else (auth/token/jwks/
# end_session endpoints, signing algorithms) comes from discovery at
# <issuer>/.well-known/openid-configuration.
#
# OIDC_ISSUER_URL=https://idp.example.com/realms/memd
# OIDC_CLIENT_ID=memd
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://memd.example.com/auth/callback

# Optional. Space-separated scopes (default "openid profile email"). Add
# offline_access if your IdP requires it to issue refresh tokens.
# OIDC_SCOPES=openid profile email offline_access

# Optional RP-initiated logout target.
# OIDC_POST_LOGOUT_REDIRECT_URI=https://memd.example.com/
